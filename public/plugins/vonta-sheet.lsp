;; AutoCAD for Windows. Load with APPLOAD and run VONTAPDF in a layout.
(defun c:VONTAPDF (/ *error* oldbg doc plot output result)
  (vl-load-com)
  (setq oldbg (getvar "BACKGROUNDPLOT"))
  (defun *error* (msg)
    (setvar "BACKGROUNDPLOT" oldbg)
    (if msg (princ (strcat "\n" msg)))
    (princ))
  (cond
    ((= (getvar "TILEMODE") 1)
      (princ "\nSelect the dimensioned paper-space layout first."))
    ((setq output (getfiled "Save VONTA blueprint PDF" (strcat (getvar "DWGPREFIX") (getvar "CTAB") ".pdf") "pdf" 1))
      (if (findfile output)
        (princ "\nChoose a new filename to keep the previous revision.")
        (progn
          (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
          (setq plot (vla-get-Plot doc))
          (setvar "BACKGROUNDPLOT" 0)
          (setq result (vl-catch-all-apply 'vla-PlotToFile (list plot output "DWG To PDF.pc3")))
          (setvar "BACKGROUNDPLOT" oldbg)
          (if (and (not (vl-catch-all-error-p result)) (findfile output))
            (princ (strcat "\nSaved " output ". Open the project blueprint register in VONTA to upload the sheet."))
            (princ "\nPlot failed. Check the layout page setup and DWG To PDF.pc3 plotter."))))))
  (princ))
(princ "\nVONTA loaded. Run VONTAPDF in the sheet layout.")
(princ)
